{
    "name": "doccheck/oauth2-doccheck-typo3",
    "description": "DocCheck OAuth2 for TYPO3 - OAuth 2.0 integration for DocCheck Access.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Christian Emmerich",
            "role": "Developer"
        },
        {
            "name": "Shirin Janse",
            "role": "Developer"
        },
        {
            "name": "Jens Knoop",
            "role": "Developer"
        },
        {
            "name": "Thorsten Daners",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-filter": "*",
        "php": "^8.2",
        "league/oauth2-client": "^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3fluid/fluid": "^4.0 || ^5.0",
        "doccheck/oauth2-doccheck": "^2.1"
    },
    "require-dev": {
        "maglnet/composer-require-checker": "^4.15",
        "ergebnis/composer-normalize": "^2.45",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "rector/rector": "^2.5.2",
        "roave/security-advisories": "dev-latest",
        "ssch/typo3-rector": "^3.0",
        "typo3/coding-standards": "^0.8",
        "typo3/testing-framework": "^8.0 || ^9.0"
    },
    "autoload": {
        "psr-4": {
            "DocCheck\\OAuth2DocCheckTypo3\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DocCheck\\OAuth2DocCheckTypo3\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "lint": "parallel-lint Classes Tests",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test:unit": "phpunit --testsuite unit",
        "test:functional": "phpunit --testsuite functional",
        "rector:dry": "rector process --dry-run",
        "dependency:check": [
            "composer audit --no-dev",
            "composer-require-checker check composer.json"
        ],
        "ci": [
            "@lint",
            "@cs:check",
            "@phpstan",
            "@test:unit",
            "@test:functional",
            "@rector:dry",
            "@dependency:check"
        ]
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "sort-packages": true,
        "allow-plugins": {
        "ergebnis/composer-normalize": true,
        "typo3/class-alias-loader": true,
        "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "oauth2_doccheck_typo3",
            "version": "0.8.0-beta",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
